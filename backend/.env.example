# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg2://bus:bus@db:5432/bus

# JWT
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MinIO / S3-compatible storage
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bus-photos
S3_REGION=us-east-1
PRESIGNED_URL_EXPIRE_SECONDS=3600

# First admin bootstrap (created on startup if set)
FIRST_ADMIN_EMAIL=admin@busapp.com
FIRST_ADMIN_PASSWORD=admin12345
